---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import profile from '../../data/profile.json';
import projects from '../../data/projects.json';

const { name } = profile;

// Curated order (lowest `order` first)
const sortedProjects = [...projects].sort((a, b) => a.order - b.order);
---

<Layout title={`Projects | ${name}`}>
	<section class="section-container py-24">
		<h1 class="text-6xl font-bold text-slate-900 mb-12">All Projects</h1>
		<ProjectGallery projects={sortedProjects} headingLevel={2} />
	</section>
</Layout>
