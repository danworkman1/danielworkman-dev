---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Daniel Workman's professional portfolio and work profile." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Google tag (gtag.js). Gated on the production hostname client-side:
		     the home page is prerendered, so a build-time (server) gate would bake
		     one answer into every deploy — localhost and previews must not fire (#15). -->
		<script is:inline>
			(function () {
				if (!['danielworkman.dev', 'www.danielworkman.dev'].includes(location.hostname)) return;
				var s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=G-VPT85FS3M3';
				document.head.appendChild(s);
				window.dataLayer = window.dataLayer || [];
				function gtag(){dataLayer.push(arguments);}
				window.gtag = gtag;
				gtag('js', new Date());
				gtag('config', 'G-VPT85FS3M3');
			})();
		</script>
		<!-- Sentry error monitoring (#17). Same client-side production-hostname
		     gate as GA4 above; the SDK is dynamic-imported so localhost and
		     preview visits never fetch it or send events. -->
		<script>
			if (['danielworkman.dev', 'www.danielworkman.dev'].includes(location.hostname)) {
				const { init } = await import('@sentry/browser');
				init({
					dsn: 'https://133caf76f5cdea6f96c1b90bd579f0f8@o4511833618448384.ingest.de.sentry.io/4511833626968144',
					environment: 'production',
				});
			}
		</script>
	</head>
	<body>
		<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100">
			<nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
				<a href="/" class="text-xl font-bold tracking-tight text-slate-900 hover:text-forest-600 transition-colors">
					DW<span class="text-forest-500">.</span>
				</a>
				<ul class="flex gap-6 md:gap-8">
					<li><a href="/" class="nav-link text-sm font-medium">Home</a></li>
					<li><a href="/projects" class="nav-link text-sm font-medium">Projects</a></li>
					<li><a href="/blog" class="nav-link text-sm font-medium">Blog</a></li>
					<li><a href="/#about" class="nav-link text-sm font-medium">About</a></li>
				</ul>
			</nav>
		</header>

		<main class="pt-16">
			<slot />
		</main>

		<footer class="border-t border-slate-100 py-12 mt-20">
			<div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
				<p class="text-slate-500 text-sm">
					© {new Date().getFullYear()} Daniel Workman. Built with Astro & Cloudflare.
				</p>
				<div class="flex gap-6">
					<a href="https://github.com/danworkman1" class="text-slate-500 hover:text-forest-600 transition-colors text-sm" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="https://www.linkedin.com/in/danielworkman1/" class="text-slate-500 hover:text-forest-600 transition-colors text-sm" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a href="/#contact" class="text-slate-500 hover:text-forest-600 transition-colors text-sm">Contact</a>
				</div>
			</div>
		</footer>
	</body>
</html>
